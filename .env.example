# Copy to .env and fill in real values. Never commit .env.

# config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only read by config.settings.prod. Example:
# postgres://branchtasks:password@db:5432/branchtasks
# The password here MUST match POSTGRES_PASSWORD below — docker-compose.yml's
# `db` service is a separate Postgres container that only knows its own
# password via POSTGRES_PASSWORD; DATABASE_URL is how `web` authenticates to
# it, so the two have to agree or `web` never gets past its first query.
DATABASE_URL=

# Read directly by docker-compose.yml (its own ${...} substitution, not via
# Django) to set the `db` service's Postgres password on first container
# start. Must match the password embedded in DATABASE_URL above.
POSTGRES_PASSWORD=

# prod.py forces HTTPS (redirect + secure cookies + HSTS) by default, but
# nginx.conf only terminates plain HTTP — it has no TLS server block. Leave
# this True only once nginx (or a proxy in front of it) actually terminates
# TLS for your domain (see the deployment runbook in README for the certbot
# step); set to False for the initial HTTP-only bring-up on a bare IP, or
# every request will be redirected to an https:// that nothing serves.
DJANGO_FORCE_HTTPS=True

# In-app bell is always on. Email is a v1-optional extra channel — off until
# EMAIL_ENABLED=True and real SMTP credentials are supplied.
EMAIL_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@branchtasks.local
